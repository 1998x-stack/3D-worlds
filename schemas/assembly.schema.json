{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3D Worlds Assembly Schema v1.0",
  "description": "Structural editable rigid assembly; graph checks do not prove collision-free mechanisms, structural loads or physical fit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system_id",
    "units",
    "up_axis",
    "root_part",
    "parts",
    "joints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "name": {
      "type": "string"
    },
    "units": {
      "const": "m"
    },
    "up_axis": {
      "const": "Y"
    },
    "root_part": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "joints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/joint"
      }
    },
    "collision_exclusions": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "quaternion_xyzw"
      ],
      "properties": {
        "position_m": {
          "$ref": "#/$defs/vec3"
        },
        "quaternion_xyzw": {
          "$ref": "#/$defs/quat"
        }
      }
    },
    "collider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shape",
        "center_m",
        "size_m"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "shape": {
          "const": "box"
        },
        "center_m": {
          "$ref": "#/$defs/vec3"
        },
        "size_m": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "colliders"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/frame"
        },
        "colliders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/collider"
          }
        }
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "parent",
        "child",
        "parent_frame",
        "child_frame"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "fixed",
            "revolute",
            "prismatic"
          ]
        },
        "parent": {
          "type": "string"
        },
        "child": {
          "type": "string"
        },
        "parent_frame": {
          "$ref": "#/$defs/frame"
        },
        "child_frame": {
          "$ref": "#/$defs/frame"
        },
        "axis": {
          "$ref": "#/$defs/vec3"
        },
        "limits": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "default": {
          "type": "number"
        }
      }
    }
  }
}
